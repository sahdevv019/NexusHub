rules_version = '2';

// Cloud Storage Security Rules for NexusHub (Milestone 7 Hardened)
// Project: nexushub-955d4
// Note: Project images are now hosted directly in Git repository static assets (/assets/projects/...).
// Firebase Storage is retained purely for backward-compatible read access to legacy assets.
// Direct writes and arbitrary uploads to Firebase Storage are strictly disabled.

service firebase.storage {
  match /b/{bucket}/o {

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verified owner authorization
    function isOwner() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email.lower() == 'ayushpathak200718@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Check if uploaded file is a safe, validated image type (SVG disallowed for security)
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Project media assets (legacy covers, screenshots)
    match /projects/{projectId}/{allPaths=**} {
      // Public can view existing legacy project images
      allow read: if true;

      // New uploads are strictly disallowed (images are stored as static repository assets)
      allow write: if false;

      // Only verified owner can delete legacy project assets if manual cleanup is needed
      allow delete: if isOwner();
    }

    // User profile images (legacy avatars if any)
    match /users/{userId}/{allPaths=**} {
      // Legacy user avatars are readable
      allow read: if true;

      // New user uploads are disabled (avatars use auth photoURL or local SVG/emoji)
      allow write: if false;

      // User or verified owner can remove legacy avatar
      allow delete: if (isAuthenticated() && request.auth.uid == userId) || isOwner();
    }
  }
}
